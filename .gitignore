# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Playwright output (generated at runtime, never committed) ─────────────────
test-results/          # screenshots, videos, traces from failed tests
playwright-report/     # HTML report generated by `npx playwright show-report`
.playwright/           # internal playwright state cache

# ── TypeScript build output ───────────────────────────────────────────────────
dist/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.local

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
